theme_override_styles/normal = SubResource("StyleBoxEmpty_log_rich")
bbcode_enabled = true
text = "[color=#2b2520]· [子时] 新岁初启，山门诸殿点灯待命。[/color]
[color=#5b4d42]· [丑时] 灵田 [2,-1] 灌溉完毕，地力稍涨。[/color]
[color=#5b4d42]· [辰时] 文书封存，主存档归档完成。[/color]
[color=#8a6a3b]· [午时] 探险队大捷，缴获玄金廿一两。[/color]
[color=#9e2a22]· [申时] 户部重编，调拨 6 人至农亩。[/color]"
